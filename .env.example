# Local development. Production must use NODE_ENV=production and DATABASE_URL.
NODE_ENV=development
PORT=3001
DATABASE_PATH=data/astralis.db

# Hostinger MySQL example:
# DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/DB_NAME
# DATABASE_SSL=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Closed by default in production. Enable only when public signup is intended.
ALLOW_REGISTRATION=false

# Optional MapLibre style URL for production map hosting. If omitted, the Atlas
# uses OpenStreetMap raster tiles. Set this at frontend build time.
# VITE_MAP_STYLE_URL=https://your-map-provider.example/style.json

# Directory location images. Production uses any S3-compatible object store
# (for example Cloudflare R2, AWS S3, or Railway Buckets).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=asterivum-directory
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# IMAGE_PUBLIC_BASE_URL=https://media.example.com
# Set the same public URL when compiling the frontend:
# VITE_IMAGE_PUBLIC_BASE_URL=https://media.example.com
# Development only; production does not persist local container files.
UPLOAD_DIRECTORY=data/uploads

# One-time bootstrap. Remove ADMIN_INITIAL_PASSWORD after the first successful start.
# ADMIN_EMAIL=owner@example.com
# ADMIN_INITIAL_PASSWORD=use-a-unique-password-of-14-or-more-characters
